# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lolstats

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_PATCH_NOTES=1800

# Riot Games API
RIOT_API_KEY=your_riot_api_key_here

# Application
DEBUG=false
APP_VERSION=0.1.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# AI Coach
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_MODE=responses
